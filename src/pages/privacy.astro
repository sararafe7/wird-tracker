---
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

const t = useTranslations("ar");
---

<Layout title={t("privacy.title")}>
  <main class="mx-auto w-full max-w-xl flex-1 px-4 py-8">
    <article class="card space-y-4 leading-relaxed text-slate-700">
      <h1 class="text-2xl font-bold text-slate-900">ملاحظة الخصوصية</h1>
      <p>
        يستخدم «وِرد» خدمة تسجيل الدخول المشتركة auth.hasanat.dev، ويصل إلينا منها معرّف الحساب والاسم
        والبريد الإلكتروني.
      </p>
      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900">ما نحفظه</h2>
        <ul class="list-disc space-y-1 ps-5">
          <li>لكل مبادرة: اسمها، ومن أنشأها، وهل هي موقوفة.</li>
          <li>
            لمن يشرف على مبادرة أو يدير مجموعة: الاسم والبريد الإلكتروني، لمعرفة من يحق له الدخول إلى
            كل مبادرة ومجموعة. لا نحفظ الصورة.
          </li>
          <li>
            لأعضاء المجموعات (أخوات أو إخوة): الاسم كما يكتبه المسؤول/ة، وعدد صفحات الورد، وسجلّ القراءة
            اليومي (التاريخ والقيمة، وقراءة سورتي الكهف والملك). الأعضاء لا يسجّلون الدخول، ويُفضَّل
            الاكتفاء بالاسم الأول.
          </li>
        </ul>
      </section>
      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900">من يرى البيانات</h2>
        <ul class="list-disc space-y-1 ps-5">
          <li>يمكن لأي شخص يسجّل الدخول بحساب حسنات أن ينشئ مبادرة، فيصبح مشرفها.</li>
          <li>
            بيانات كل مبادرة (مجموعاتها وأعضاؤها وسجلّات القراءة) لا يراها إلا مشرفو هذه المبادرة،
            ويرى المسؤول/ة مجموعاته فقط.
          </li>
          <li>
            يرى مدير/ة التطبيق لكل مبادرة اسمها، وأسماء مشرفيها وبريدهم، وعدد مجموعاتها وأعضائها فقط،
            ولا يرى أسماء الأعضاء ولا سجلّات القراءة في مبادرة إلا إذا كان مشرفاً أو مسؤولاً فيها.
            ويمكنه إيقاف أي مبادرة أو حذفها.
          </li>
          <li>لا نشارك البيانات مع أي جهة، ولا نبيعها، ولا نستخدمها للإعلانات.</li>
        </ul>
      </section>
      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900">أين تُحفظ</h2>
        <p>
          في قاعدة بيانات على Cloudflare ضمن حساب حسنات. ويستطيع فريق حسنات تقنياً الوصول إلى قاعدة
          البيانات عبر Cloudflare.
        </p>
      </section>
      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900">الحذف</h2>
        <p>
          حذف عضو أو مجموعة أو مبادرة من التطبيق يحذف سجلّاتها، ومن لم يعد مشرفاً أو مسؤولاً في
          أي مبادرة يُحذف اسمه وبريده. ولطلب حذف أي بيانات أخرى، يُرجى التواصل مع مشرف/ة المبادرة،
          وننفّذ الطلب خلال 30 يوماً.
        </p>
      </section>
      <a href="/" class="inline-block text-hasanat hover:underline">{t("common.back_to_app")}</a>
    </article>
  </main>
</Layout>
