---
import WirdApp from "@/components/WirdApp";
import ar from "@/i18n/ar.json";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ar");
---

<Layout title={t("wird.title")}>
  <nav class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur-sm">
    <div class="mx-auto flex h-14 max-w-xl items-center px-4">
      <a href="/ar/" class="text-lg font-bold text-hasanat">{t("site.name")}</a>
    </div>
  </nav>

  <main class="mx-auto w-full max-w-xl flex-1 px-4 py-6">
    <WirdApp client:only="react" t={ar} />
  </main>

  <footer class="py-6 text-center text-xs text-stone-500">
    <a href="/ar/privacy" class="hover:text-slate-700 hover:underline">{t("privacy.link")}</a>
  </footer>
</Layout>
